<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Paid_Date_Required_When_Succeeded</fullName>
    <active>true</active>
    <description>Un paiement reçu doit avoir une date d'encaissement.</description>
    <errorConditionFormula>AND(
        ISPICKVAL(Status__c, 'Succeeded'),
        ISBLANK(Paid_Date__c)
    )</errorConditionFormula>
    <errorDisplayField>Paid_Date__c</errorDisplayField>
    <errorMessage>Indiquez la date d'encaissement d'un paiement reçu.</errorMessage>
</ValidationRule>
