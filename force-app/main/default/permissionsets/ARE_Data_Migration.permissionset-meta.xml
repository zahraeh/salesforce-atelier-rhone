<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>ARE - Migration de données</label>
    <description>Utilisateur de migration uniquement : contourne les règles de validation, écrit Legacy_ID__c. À retirer après la reprise.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <customPermissions>
        <enabled>true</enabled>
        <name>Bypass_Validation</name>
    </customPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Legacy_ID__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.SIRET__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.VAT_Number__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.NAF_Code__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
